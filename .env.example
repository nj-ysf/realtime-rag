# Template for .env, used when running the API / ingestion from the venv on your machine.
# Copy to .env (git-ignored) and fill in real values. Real environment variables override it.
# Docker compose uses a separate file: infrastructure/.env (see infrastructure/.env.example).

# On Windows, 127.0.0.1 is much faster than "localhost" (which tries IPv6 first).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=products

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM backend: "ollama" (local) or "gemini" (Google API)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only needed when LLM_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

API_HOST=0.0.0.0
API_PORT=8000

# Optional tuning
# OLLAMA_TIMEOUT_SECONDS=120
# RAG_DEFAULT_TOP_K=5
# RAG_MAX_TOP_K=20
# RAG_MIN_SCORE=0.25
# LOG_LEVEL=INFO
# LOG_FORMAT=text   # or json
