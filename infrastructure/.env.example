# Template for infrastructure/.env (used by docker compose).
#   copy .env.example .env      then fill in real values. Never commit .env.

POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL (bound to 127.0.0.1 only). Change if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# RAG API container: "ollama" (local) or "gemini" (Google API)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 0 = no hidden "thinking" tokens (much faster for RAG). Empty = model default.
# GEMINI_THINKING_BUDGET=0
